{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raast-qr",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "raast-qr.syedyawar.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
